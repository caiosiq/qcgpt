{
    "run_name": "qcgpt3_stage2_physics",
    "prefix": "stage2_physics",
    "seed": 42,

    "ckpt": "INSERT_PATH_TO_STAGE1_CHECKPOINT_HERE",

    "num_samples": 500000,
    "val_split": 0.05,
    "batch_size": 64,
    "num_workers": 16,
    "pin_memory": true,
    
    "augment_commutation": true,
    "augment_permutation": true,

    "num_epochs": 100,
    "lr_enc": 1e-4,
    "lr_dec": 1e-4,
    "weight_decay": 0.01,
    "optimizer": "adam",
    
    "scheduler": "exp_warmup",
    "warmup_epochs": 10,
    "gamma": 0.95,

    "lambda_sup": 0.1,
    
    "use_entanglement": true,
    "lambda_ent_teacher": 0.1,
    "lambda_ent_consistency": 0.9,
    
    "use_unitary_loss": true,
    "lambda_U": 0.9,
    
    "use_noise": true,
    "lambda_noise": 0.9,
    "noise_scale": 1.0,
    
    "softmax_temp": 1.0,
    "temp_min": 0.1,
    "temp_schedule": "cosine",

    "use_curriculum": true,
    "curriculum_start_depth": 20,
    "curriculum_end_depth": 32,
    "curriculum_depth_step": 2,
    "curriculum_increase_every": 10,
    "curriculum_max_noise": 1.0,
    "curriculum_noise_warmup": 20
}